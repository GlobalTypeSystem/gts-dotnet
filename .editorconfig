root = true

# Baseline whitespace conventions enforced by `make fmt` (dotnet format).
# Kept intentionally minimal so the formatter's built-in C# defaults apply
# without imposing heavy style opinions.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
