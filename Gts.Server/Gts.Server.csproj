  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gts.Application\Gts.Application.csproj" />
    <ProjectReference Include="..\Gts.Store\Gts.Store.csproj" />
  </ItemGroup>

</Project>
